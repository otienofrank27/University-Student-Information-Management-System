# Docker deployment settings. Copy this file to .env and change the passwords.
# Passwords must not contain the characters  '  or  \

# Public port of the website
WEB_PORT=8080

# Set to 1 only when the site sits behind a reverse proxy (Caddy, Nginx, Cloudflare)
TRUST_PROXY=0

# 1 = load the demo students, courses and marks. 0 = start empty (admin account only).
LOAD_SAMPLE_DATA=1

# Database passwords (used the first time the database volume is created)
DB_ROOT_PASSWORD=change-this-root-password
SIS_ADMIN_PASSWORD=change-this-admin-db-password
SIS_LECTURER_PASSWORD=change-this-lecturer-db-password
