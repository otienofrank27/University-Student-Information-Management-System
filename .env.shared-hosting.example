# Shared hosting (cPanel) settings. Copy this file to .env in the site folder.
# Shared hosts give you one database user, so both roles use the same one.
APP_ENV=production
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_sis
DB_ADMIN_USER=cpaneluser_sisuser
DB_ADMIN_PASS=the-database-user-password
DB_LECTURER_USER=cpaneluser_sisuser
DB_LECTURER_PASS=the-database-user-password

# The Backup page needs exec() and mysqldump, which most shared hosts disable.
# Use your host's own backup tool or phpMyAdmin Export instead.
BACKUP_DB_USER=cpaneluser_sisuser
BACKUP_DB_PASS=the-database-user-password
